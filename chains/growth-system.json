{
  "name": "growth-system",
  "mode": "ordered-stages-with-conditional-branches",
  "stages": [
    {
      "id": "route",
      "skills": ["growth-strategist"],
      "output": "growth brief"
    },
    {
      "id": "baseline",
      "skills": ["growth-audit", "evidence-led-growth-audit"],
      "selection": "use evidence-led-growth-audit when a comprehensive report needs source reconciliation and artifact verification",
      "output": "audit scorecard"
    },
    {
      "id": "measure",
      "skills": ["marketing-tagging-audits"],
      "condition": "when tagging, consent, event provenance, or attribution quality is uncertain",
      "output": "measurement evidence and unresolved gaps"
    },
    {
      "id": "diagnose",
      "skills": [
        "customer-research",
        "channel-fit-diagnostic",
        "power-user-curve",
        "saas-unit-economics-audit",
        "paid-analysis-review",
        "conversational-ads-optimization"
      ],
      "selection": "invoke only specialists required by the current constraint",
      "output": "constraint brief"
    },
    {
      "id": "roadmap",
      "skills": ["growth-roadmap"],
      "output": "quarterly roadmap"
    },
    {
      "id": "design",
      "skills": [
        "offer-design",
        "onboarding-activation",
        "product-led-acquisition",
        "viral-loop",
        "retention-state"
      ],
      "selection": "route by the diagnosed constraint",
      "output": "intervention specification"
    },
    {
      "id": "test",
      "skills": ["experiment-design"],
      "output": "experiment specification"
    },
    {
      "id": "execute",
      "skills": ["paid-media-creative-operations"],
      "selection": "use for paid creative execution; otherwise use the tools required by the intervention",
      "condition": "only within the approved experiment and execution scope",
      "output": "verified execution result"
    },
    {
      "id": "operationalize",
      "skills": ["marketing-loops"],
      "condition": "only after evidence supports repeating the action",
      "output": "loop specification"
    },
    {
      "id": "learn",
      "skills": ["growth-audit", "growth-roadmap", "growth-strategist"],
      "output": "decision record and refreshed constraint"
    }
  ]
}
